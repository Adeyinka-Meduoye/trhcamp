rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /attendees/{attendeeId} {
      allow read, write: if true;
    }
    match /expectations/{expectationId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /admin_users/{userId} {
      allow read, write: if true;
    }
  }
}
