# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin Passwords (Server Environment Variables)
ADMIN_PASS_PASTOR=
ADMIN_PASS_CHURCH_ADMIN=
ADMIN_PASS_ASST_ADMIN=
ADMIN_PASS_SENATE=
ADMIN_PASS_TECH=
ADMIN_PASS_CAMP_DIR=
ADMIN_PASS_INFO_DESK=
ADMIN_PASS_INFO_DESK_TWO=

# Gmail SMTP Configuration for sending Digital Pass emails
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

